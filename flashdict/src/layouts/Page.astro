---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  schema?: Record<string, unknown>;
  bodyClass?: string;
}
const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/assets/lookup-mac.png',
  schema,
  bodyClass,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090b" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="闪卡词典 FlashDict" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="闪卡词典 FlashDict 产品界面" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageURL} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/app-icon.png" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script>
      import '../scripts/site.js';
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳转到主要内容</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
