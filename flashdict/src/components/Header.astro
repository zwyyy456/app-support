---
import { site } from '../site.config.mjs';

interface Props { lang?: 'zh' | 'en' }
const { lang = 'zh' } = Astro.props;
const isEn = lang === 'en';
const homePath = isEn ? '/en' : '/';
const onHome = Astro.url.pathname === homePath || Astro.url.pathname === `${homePath}/`;
const home = onHome ? '' : homePath;
const appStoreURL = site.downloads.ios || site.downloads.mac || `${home}#download`;
const copy = isEn
  ? {
      homeLabel: 'Flashcard Dict home',
      nav: 'Main navigation',
      menu: 'Open navigation menu',
      menuClose: 'Close navigation menu',
      links: [['#context', 'Sentence cards'], ['#why', 'Why it works'], ['#dictionaries', 'Dictionaries'], ['#pricing', 'Free & Pro']],
      cta: 'App Store',
      switchLabel: '中文',
      switchHref: '/',
      switchLang: 'zh-CN',
    }
  : {
      homeLabel: '闪卡词典首页',
      nav: '主导航',
      menu: '打开导航菜单',
      menuClose: '关闭导航菜单',
      links: [['#context', '原句制卡'], ['#why', '设计理念'], ['#features', '义项制卡'], ['#pricing', '免费与会员']],
      cta: 'App Store 下载',
      switchLabel: 'EN',
      switchHref: '/en',
      switchLang: 'en',
    };
---
<header class="site-header">
  <nav class="nav wrap" aria-label={copy.nav}>
    <a class="brand" href={homePath} aria-label={copy.homeLabel}>
      <img src="/assets/app-icon.png" alt="" width="30" height="30" />
      {isEn ? <span>Flashcard Dict</span> : <span>闪卡词典 <span class="brand-en">FlashDict</span></span>}
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links" aria-label={copy.menu} data-open-label={copy.menu} data-close-label={copy.menuClose}><span></span><span></span></button>
    <div class="nav-links" id="nav-links">
      {copy.links.map(([hash, label]) => <a href={`${home}${hash}`}>{label}</a>)}
      {!isEn && <a href="/support">使用支持</a>}
      <a class="lang-switch" href={copy.switchHref} hreflang={copy.switchLang} lang={copy.switchLang}>{copy.switchLabel}</a>
    </div>
    <a class="button button-small nav-cta" href={appStoreURL} target={appStoreURL.startsWith('http') ? '_blank' : undefined} rel={appStoreURL.startsWith('http') ? 'noopener' : undefined}>{copy.cta} <span aria-hidden="true">↗</span></a>
  </nav>
</header>
