---
const home = Astro.url.pathname === '/' ? '' : '/';
---
<header class="site-header">
  <nav class="nav wrap" aria-label="主导航">
    <a class="brand" href="/" aria-label="闪卡词典首页">
      <img src="/assets/app-icon.png" alt="" width="30" height="30" />
      <span>闪卡词典 <span class="brand-en">FlashDict</span></span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="打开导航菜单"><span></span><span></span></button>
    <div class="nav-links" id="nav-links">
      <a href={`${home}#experience`}>产品概览</a>
      <a href={`${home}#features`}>义项制卡</a>
      <a href={`${home}#devices`}>多端学习</a>
      <a href="/support">使用支持</a>
    </div>
    <a class="button button-small nav-cta" href={`${home}#download`}>获取闪卡词典 <span aria-hidden="true">↗</span></a>
  </nav>
</header>
