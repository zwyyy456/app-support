---
import Page from '../layouts/Page.astro';
import ProductVideo from '../components/ProductVideo.astro';
import { site, browsers } from '../site.config.mjs';
import { adaptedDictionaries, bundledDictionaries, adaptedDictionaryCount } from '../content/dictionaries.mjs';

const desktopScreenshots = [
  {
    key: 'lookup',
    src: site.screenshots.lookup,
    alt: '闪卡词典 Mac 查词界面，展示 commodity 的释义、例句和义项制卡入口',
    width: 3024,
    height: 1898,
    title: '在自己的 MDX 词典里查词',
    description: '查看完整词条、例句和发音，并从适配词典中选择这次需要的义项。',
  },
  {
    key: 'review',
    src: site.screenshots.review,
    alt: '闪卡词典 Mac 复习界面，展示 commodity 的答案和四个评分按钮',
    width: 1800,
    height: 1304,
    title: '先回忆，再根据记忆情况评分',
    description: '查看答案后，选择一个评分。FSRS-6 会根据记忆情况安排下次复习。',
  },
  {
    key: 'library',
    src: site.screenshots.library,
    alt: '闪卡词典 Mac 词典管理界面，展示已导入词典和当前词典设置',
    width: 3024,
    height: 1898,
    title: '导入并管理自己的词典',
    description: '添加 MDX 词典、调整使用顺序，并决定查词时优先显示哪一本。',
  },
];
const appStoreURL = site.downloads.ios || site.downloads.mac || '#download';
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: '闪卡词典 FlashDict',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'iOS 17+, iPadOS 17+, macOS 14+',
  description: '浏览网页时双击生词，自动带上原句和翻译；选择当前义项，把单词、原句和释义保存为闪卡，并使用 FSRS-6 安排复习。',
  downloadUrl: appStoreURL,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'CNY',
  },
};
const external = (url) => (url && url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---
<Page
  title="闪卡词典 FlashDict — 查词时，同时保存原句"
  description="浏览网页时双击生词，弹窗自动带上原句和翻译。点一下当前义项旁的「+」，把单词、原句和释义保存为闪卡，用 FSRS-6 复习。支持 Chrome、Edge、Firefox、Safari。"
  ogTitle="闪卡词典 — 查词时，同时保存原句"
  ogDescription="双击生词，自动带上原句和翻译；点「+」只收这句话里的那个义项，做成闪卡。"
  schema={softwareSchema}
  alternates={{ zh: '/', en: '/en' }}
>
<main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow"><span class="little-mark" aria-hidden="true"></span> MDX 词典 × 原句制卡 × FSRS-6</div>
        <h1 id="hero-title">查词时，<br><span>同时保存原句</span></h1>
        <p class="hero-description">浏览网页时双击或划选生词，弹窗里依次是原句、翻译和已经按义项拆开的释义。点一下当前义项旁的「+」，单词、原句和这个义项就成了一张闪卡。</p>
        <div class="hero-actions">
          <a class="button button-primary" href={appStoreURL} {...external(appStoreURL)}>在 App Store 下载 <span aria-hidden="true">↗</span></a>
          <a class="button button-quiet" href="#context">查看完整演示 <span aria-hidden="true">↓</span></a>
        </div>
        <p class="browser-line">
          <span>浏览器扩展</span>
          {browsers.map(({ key, name }) => site.extensions[key]
            ? <a href={site.extensions[key]} {...external(site.extensions[key])}>{name}</a>
            : <span class="browser-name">{name}</span>)}
          <span class="browser-more">其他 App 可通过系统分享发送原句</span>
        </p>
      </div>
      <figure class="hero-demo">
        <div class="hero-demo-frame">
          <video data-autoplay autoplay muted loop playsinline preload="auto" poster="/videos/hero-loop.jpg" width="712" height="742" aria-label="实际录屏：双击单词后，弹窗显示原句、翻译和按义项拆开的释义，选择义项后生成带原句的闪卡">
            <source src="/videos/hero-loop.mp4" type="video/mp4" />
          </video>
        </div>
        <figcaption>实际录屏 · 原句与翻译 → 选择义项 → 生成闪卡</figcaption>
      </figure>
    </section>

    <section class="experience wrap" id="experience" aria-label="App 实际截图">
      <div class="experience-header">
        <div class="product-tabs" role="tablist" aria-label="切换产品界面">
          <button id="tab-lookup" role="tab" aria-selected="true" aria-controls="panel-lookup" tabindex="0"><span>01</span> 查词</button>
          <button id="tab-review" role="tab" aria-selected="false" aria-controls="panel-review" tabindex="-1"><span>02</span> 复习</button>
          <button id="tab-library" role="tab" aria-selected="false" aria-controls="panel-library" tabindex="-1"><span>03</span> 词典</button>
        </div>
      </div>
      <div class="product-stage">
        <div class="stage-glow" aria-hidden="true"></div>
        {desktopScreenshots.map(({ key, src, alt, width, height, title, description }) => (
          <div class="product-panel" id={`panel-${key}`} role="tabpanel" aria-labelledby={`tab-${key}`} tabindex="0" hidden={key !== 'lookup'}>
            <div class="product-canvas">
              <button
                class="screenshot-preview"
                type="button"
                data-lightbox-src={src}
                data-lightbox-alt={alt}
                data-lightbox-title={title}
                aria-label={`${alt}，放大查看`}
              >
                <img class="screenshot-image" src={src} alt={alt} width={width} height={height} loading="lazy" />
                <span class="screenshot-expand" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M7.5 3.5h-4v4M12.5 3.5h4v4M7.5 16.5h-4v-4M12.5 16.5h4v-4"/></svg>
                  查看大图
                </span>
              </button>
            </div>
            <div class="product-caption">
              <strong>{title}</strong>
              <p>{description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <dialog class="screenshot-lightbox" id="screenshot-lightbox" aria-labelledby="screenshot-lightbox-title">
      <div class="lightbox-shell">
        <header class="lightbox-header">
          <p id="screenshot-lightbox-title"></p>
          <button class="lightbox-close" type="button" aria-label="关闭大图预览"><span aria-hidden="true">×</span></button>
        </header>
        <div class="lightbox-body"><img id="screenshot-lightbox-image" alt="" /></div>
      </div>
    </dialog>

    <section class="context-section wrap" id="context" aria-labelledby="context-title">
      <div class="section-heading">
        <div><div class="section-kicker"><span>01</span> 原句从哪里来</div><h2 id="context-title">浏览器取词时，自动提取原句。<br><span class="muted">其他 App 中，选中句子后发送到 FlashDict。</span></h2></div>
        <p>在弹出的原句查词窗口里，点一下想查的单词，再选择这次用到的释义，就能把单词、原句和释义一起做成闪卡。</p>
      </div>
      <ProductVideo
        id="context-video"
        src="/videos/contextual-flashcard.mp4"
        poster="/videos/contextual-flashcard.jpg"
        width={1920}
        height={1096}
        title="从网页中的一个词，到带原句的闪卡"
        duration="45 秒"
        description="Safari 实际操作：取词时自动带入原句，选择当前义项，再查看保存后的闪卡。"
      />
      <p class="context-caption">支持 Chrome、Edge、Firefox 和 Safari（Helium、Zen、Floorp 等同内核浏览器也可连接）；按义项制卡需要词典已有适配。<a class="text-link" href="/support#browser-setup">查看浏览器连接教程 →</a></p>
    </section>

    <section class="why-section wrap" id="why" aria-labelledby="why-title">
      <div class="section-heading">
        <div><div class="section-kicker"><span>02</span> 设计理念</div><h2 id="why-title">为什么是「原句 + 单个义项」。</h2></div>
        <p>闪卡的正面是单词和你读到的原句，背面只有你选的那一个义项。这个设计来自两条被很多人验证过的做法。</p>
      </div>
      <div class="why-grid">
        <article class="why-item">
          <span class="why-index" aria-hidden="true">A</span>
          <h3>原句：留住当时的语境</h3>
          <p>复习时看到自己读过的那句话，更容易想起这个词在那里的意思，也顺便记住了它的搭配和用法。这一做法受<a class="inline-link" href="https://www.laohuang.net/20170319/the-new-way-of-vocabulary-studying/" target="_blank" rel="noopener">「原句法」背单词</a>的启发。</p>
        </article>
        <article class="why-item">
          <span class="why-index" aria-hidden="true">B</span>
          <h3>一卡一义：一次只记一个意思</h3>
          <p>常见词往往有好几个义项，全放进背面，复习时很难判断自己记没记住。一张卡只对应一个意思，翻到背面就知道自己有没有想对。这对应 SuperMemo 制卡原则里的<a class="inline-link" href="https://www.supermemo.com/en/blog/twenty-rules-of-formulating-knowledge" target="_blank" rel="noopener">「最少信息原则」</a>。</p>
        </article>
        <article class="why-item">
          <span class="why-index" aria-hidden="true">C</span>
          <h3>FSRS-6：在快忘的时候复习</h3>
          <p>每次复习后选择「重来 / 困难 / 良好 / 简单」，FSRS-6 会根据这张卡的复习记录安排下一次复习，不需要自己计算间隔。</p>
        </article>
      </div>
    </section>

    <section class="detail-section wrap" id="features" aria-labelledby="detail-title">
      <div class="section-heading">
        <div><div class="section-kicker"><span>03</span> 按义项制卡</div><h2 id="detail-title">选择一个义项，单独制卡。</h2></div>
        <p>在已适配的词典中，点一下释义旁的「+」，就能用这个义项和例句创建闪卡。从原句查词时，原句也会一起保存。</p>
      </div>
      <figure class="sense-proof">
        <button
          class="sense-proof-preview screenshot-preview"
          type="button"
          data-lightbox-src={site.screenshots.lookup}
          data-lightbox-alt="闪卡词典 Mac 查词界面，义项右侧显示单独的制卡按钮"
          data-lightbox-title="按义项制卡"
          aria-label="放大查看闪卡词典按义项制卡的实际界面"
        >
          <span class="sense-proof-viewport">
            <img class="sense-proof-image" src={site.screenshots.lookup} alt="闪卡词典实际查词界面，不同义项右侧分别显示加号按钮" width="3024" height="1898" loading="lazy" />
            <span class="sense-proof-target" aria-hidden="true"></span>
            <span class="sense-proof-callout" aria-hidden="true"><span>为这个义项制卡</span><span class="sense-proof-line"></span></span>
          </span>
          <span class="screenshot-expand" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M7.5 3.5h-4v4M12.5 3.5h4v4M7.5 16.5h-4v-4M12.5 16.5h4v-4"/></svg>
            查看完整界面
          </span>
        </button>
        <figcaption><p>高亮处是当前义项的制卡按钮。</p></figcaption>
      </figure>

      <div class="dict-support" id="dictionaries" aria-labelledby="dict-title">
        <div class="dict-support-intro">
          <h3 id="dict-title">已适配义项拆分的词典</h3>
          <p>目前已为 {adaptedDictionaryCount} 个常见 MDX 词典版本适配义项拆分，涵盖下面这些系列。适配按具体词典文件识别，同一系列的其他制作版本可能还没有适配，以查词时义项旁是否出现「+」为准。</p>
        </div>
        <ul class="dict-list">
          {adaptedDictionaries.map(({ zh }) => <li>{zh}</li>)}
        </ul>
        <div class="dict-notes">
          <p><strong>内置词典</strong>：{bundledDictionaries.map(({ name }) => name).join('、')}，安装后即可查词，不占免费版的外部词典额度。</p>
          <p><strong>其他词典</strong>：没有适配的词典也能正常查词，并可以整条收藏为闪卡。希望适配某本词典，欢迎<a class="inline-link" href="mailto:zwyyy456@foxmail.com">发邮件告诉我</a>。</p>
        </div>
      </div>
    </section>

    <section class="devices-section wrap" id="devices" aria-labelledby="devices-title">
      <div class="section-kicker"><span>04</span> 多设备使用</div>
      <div class="section-heading"><h2 id="devices-title">Mac、iPhone 和 iPad 都可以查词和复习。</h2><p>Mac 适合分栏查词和键盘操作；iPhone 与 iPad 方便随时查询和复习。</p></div>
      <div class="devices-grid">
        <div class="device-details">
          <div class="device-feature"><span class="device-icon" aria-hidden="true">⌘</span><div><h3>Mac 上查词和制卡</h3><p>使用分栏查词、键盘快捷操作和独立复习窗口。</p><span class="system-label">macOS 14 及以上</span></div></div>
          <div class="device-feature"><span class="device-icon" aria-hidden="true">◫</span><div><h3>iPhone 与 iPad 上查词和复习</h3><p>iPhone 适合随手查询和复习；iPad 可以利用分栏查看词典内容。</p><span class="system-label">iOS / iPadOS 17 及以上</span></div></div>
          <div class="sync-note"><span class="device-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 17H5a4 4 0 0 1-.6-8A7 7 0 0 1 18 7a5 5 0 0 1 1 10h-1M8 17l4 4 4-4M12 21V11"/></svg></span><div><h3>闪卡和复习进度通过 iCloud 同步</h3><p>词典文件、图片和音频不会同步，需要在各设备分别添加。</p></div></div>
        </div>
        <figure class="mobile-showcase">
          <a class="mobile-frame" href={site.screenshots.mobile} target="_blank" rel="noopener" aria-label="在新标签页查看 iPhone 复习截图原图">
            <img class="mobile-screenshot" src={site.screenshots.mobile} alt="闪卡词典 iPhone 复习界面，展示 commodity 的答案和四个评分按钮" width="1206" height="2622" loading="lazy" />
          </a>
          <figcaption>iPhone · App 实际截图</figcaption>
        </figure>
      </div>
    </section>

    <section class="essentials-section wrap" aria-labelledby="essentials-title">
      <div class="section-heading">
        <div><div class="section-kicker"><span>05</span> 更多特性</div><h2 id="essentials-title">把本地词典用得更顺手。</h2></div>
        <p>支持批量导入、HTML / JavaScript 渲染、夜间反色、正文双击查词和批量制卡。</p>
      </div>
      <div class="essentials">
        <div class="essential-item"><span class="essential-icon" aria-hidden="true">⌘</span><h3>使用 SwiftUI 原生开发。</h3><p>面向 iPhone、iPad 和 Mac 原生开发，使用系统窗口、快捷键和分享能力，并持续优化查词速度与内存占用。</p></div>
        <div class="essential-item"><span class="essential-icon" aria-hidden="true">◐</span><h3>词典页面支持夜间反色。</h3><p>遇到没有深色样式的词典，可以单独开启夜间反色；查词、卡片预览和复习时都会生效。</p></div>
        <div class="essential-item"><span class="essential-icon essential-icon-code" aria-hidden="true">&lt;/&gt;</span><h3>兼容常见的 MDX 页面和脚本。</h3><p>查词页使用 WebKit 渲染，支持常见的 HTML、CSS、JavaScript，以及词典随附的图片和音频资源。</p></div>
        <div class="essential-item"><span class="essential-icon" aria-hidden="true">↗</span><h3>词典正文里，双击继续查。</h3><p>在词典内容中遇到另一个陌生词，双击即可继续查询，不必来回复制。</p></div>
        <div class="essential-item"><span class="essential-icon" aria-hidden="true">⌁</span><h3>选择目录，批量导入词典。</h3><p>扫描所选目录及子目录中的 MDX 词典和配套资源，减少逐本添加的操作。</p></div>
        <div class="essential-item"><span class="essential-icon" aria-hidden="true">≡</span><h3>单词列表，也能批量制卡。</h3><p>导入每行一个词的文本列表，从指定词典批量生成卡片，并跳过已有项目。</p></div>
      </div>
    </section>

    <section class="access-section wrap" id="pricing" aria-labelledby="access-title">
      <div class="section-heading">
        <div><div class="section-kicker"><span>06</span> 免费版与会员</div><h2 id="access-title">功能都能用，额度按需升级。</h2></div>
        <p>免费版只限制同时启用的外部词典数量和每日创建闪卡数量；会员会解除这两项限制。</p>
      </div>
      <div class="access-grid">
        <article>
          <div class="access-plan"><h3>免费版</h3><strong>¥0</strong></div>
          <p class="access-summary">查词、原句制卡和复习都可以直接使用。</p>
          <ul class="access-features">
            <li><span>导入并管理本地 MDX 词典</span></li>
            <li><span>Chrome / Edge / Firefox / Safari 划词和原句提取</span></li>
            <li><span>系统分享与 macOS 服务原句查词</span></li>
            <li><span>词典夜间反色与正文双击查词</span></li>
            <li><span>按义项制卡、FSRS-6 复习与 iCloud 同步</span></li>
            <li><span>同时启用外部 MDX 词典</span><strong>2 本</strong></li>
            <li><span>每台设备每日成功创建闪卡</span><strong>10 张</strong></li>
          </ul>
          <a class="access-action" href={appStoreURL} {...external(appStoreURL)}>在 App Store 免费下载 <span aria-hidden="true">↗</span></a>
        </article>
        <article class="access-member">
          <div class="access-plan"><h3>会员</h3><strong>¥3 / 月起</strong></div>
          <p class="access-summary">包含免费版全部功能，并解除两项使用额度。</p>
          <ul class="access-features">
            <li><span>免费版的全部功能</span></li>
            <li><span>同时启用外部 MDX 词典</span><strong>不限</strong></li>
            <li><span>每台设备每日成功创建闪卡</span><strong>不限</strong></li>
          </ul>
          <div class="access-options" aria-label="会员购买方案">
            <div><span>全平台月度会员</span><strong>¥3 / 月</strong></div>
            <div><span>全平台年度会员</span><strong>¥30 / 年</strong></div>
            <div><span>全平台终身会员</span><strong>¥60</strong></div>
            <div><span>移动端终身会员</span><strong>¥30</strong></div>
          </div>
          <a class="access-action access-action-primary" href={appStoreURL} {...external(appStoreURL)}>查看 App Store 当前方案 <span aria-hidden="true">↗</span></a>
        </article>
      </div>
      <p class="access-footnote">外部词典指你自己导入的词典；内置词典不计入 2 本的限制。</p>
    </section>

    <section class="faq-section wrap" id="faq" aria-labelledby="faq-title"><div><div class="section-kicker"><span>07</span> 使用支持</div><h2 id="faq-title">开始使用前，可能还想知道这些。</h2><a class="text-link" href="/support">查看使用支持 <span aria-hidden="true">↗</span></a></div><div class="faq-list">
      <details><summary>如何从阅读原句创建闪卡？<span aria-hidden="true">+</span></summary><p>在 Chrome、Edge、Firefox 和 Safari 中通过扩展查词时，FlashDict 会自动提取单词所在的句子。在其他 App 中，可以选中一句话，通过系统分享或 macOS 服务发送到 FlashDict。随后在原句窗口点选单词，并从释义中添加需要的义项。</p></details>
      <details><summary>支持哪些浏览器？<span aria-hidden="true">+</span></summary><p>支持 Chrome、Edge、Firefox 和 Safari。Helium 等 Chromium 内核浏览器，以及 Zen、Floorp 12+ 等 Firefox 内核浏览器也可以在 App 设置的「浏览器扩展」中连接。Safari 扩展随 App 一起安装。</p></details>
      <details><summary>可以使用自己的词典吗？<span aria-hidden="true">+</span></summary><p>可以。App 内置 {bundledDictionaries.map(({ name }) => name).join('、')}，也可以自由导入本地 MDX 词典，并管理词典顺序和启用状态。如果词典有配套图片、音频等资源，请一并准备对应资源文件。截图中的词典为用户自行导入，不随 App 附赠。</p></details>
      <details><summary>所有词典都支持按义项制卡吗？<span aria-hidden="true">+</span></summary><p>按义项生成精简闪卡，需要词典已有适配，目前已适配的系列见<a class="inline-link" href="#dictionaries">词典列表</a>。未适配的词典也可以通过「词典闪卡」收藏整个词条，在复习时查看对应词典内容。</p></details>
      <details><summary>闪卡如何安排复习？<span aria-hidden="true">+</span></summary><p>先尝试回忆，再显示答案，并根据记忆情况评分。App 使用 FSRS-6，根据每张卡片的学习状态和评分，安排下一次复习。</p></details>
      <details><summary>哪些内容会同步到其他设备？<span aria-hidden="true">+</span></summary><p>开启 iCloud 同步后，闪卡与复习进度会在设备间同步。词典文件及图片、音频资源不包含在内；请在其他设备上添加对应词典。同步开关的调整在下次启动 App 后生效。</p></details>
      <details><summary>翻译需要联网或额外配置吗？<span aria-hidden="true">+</span></summary><p>Apple 系统翻译需要 iOS 18 / macOS 15 或更新版本，语言支持和语言包由系统决定。DeepL 与 OpenAI 兼容服务需要自行配置、显式启用并联网使用；服务费用由相应服务商决定。</p></details>
      <details><summary>可以导入 Anki 卡片吗？<span aria-hidden="true">+</span></summary><p>当前闪卡导入、导出使用 FlashDict 自己的 JSON 格式，并不直接支持 Anki 的 APKG 文件。FSRS 是复习调度算法，不代表与 Anki 文件格式互通。</p></details>
    </div></section>

